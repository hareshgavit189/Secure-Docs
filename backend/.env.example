# =====================================================
# SecureDocs Backend — Environment Variables Template
# =====================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to git!
# =====================================================

# ── Server ────────────────────────────────────────────
PORT=5001
NODE_ENV=development

# ── MongoDB Atlas (Primary) ──────────────────────────
# Get from: Atlas → Cluster0 → Connect → Connect your application
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/securedocs?retryWrites=true&w=majority

# ── MongoDB Local Compass (Fallback) ─────────────────
MONGODB_LOCAL_URI=mongodb://localhost:27017/securedocs

# ── JWT Authentication ────────────────────────────────
# Use a long random string. Regenerate:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_jwt_secret_here

# ── HMAC Document Integrity Secret ───────────────────
# CRITICAL: Used to compute HMAC-SHA-256 for document authenticity.
# - NEVER store this value in MongoDB.
# - NEVER send this value to the frontend.
# - If this changes, existing document HMAC verification will fail.
# Regenerate:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DOCUMENT_HMAC_SECRET=your_64_char_hex_secret_here

# ── CORS Origins ──────────────────────────────────────
# Comma-separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:3000,http://localhost:5173,https://your-app.vercel.app
