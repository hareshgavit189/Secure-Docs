{
  "name": "securedocs-product-clean",
  "version": "1.0.0",
  "private": true,
  "description": "SecureDocs Full-Stack Application - Pure React.js, Node.js & MongoDB",
  "type": "module",
  "scripts": {
    "dev": "node start-all.mjs",
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "seed": "npm --prefix backend run seed",
    "build": "cd frontend && npm install && npm run build"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^16.4.7",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.9.4",
    "multer": "^2.3.0"
  }
}
